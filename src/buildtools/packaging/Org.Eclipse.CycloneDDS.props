<Project>
  <PropertyGroup>
    <CycloneDDSToolsPackageDirectory>$(MSBuildThisFileDirectory)..</CycloneDDSToolsPackageDirectory>
    <CycloneDDSDefaultExtensibility Condition="'$(CycloneDDSDefaultExtensibility)' == ''">final</CycloneDDSDefaultExtensibility>
  </PropertyGroup>
  <ItemGroup>
    <AvailableItemName Include="CycloneDDSIdl" />
  </ItemGroup>
</Project>