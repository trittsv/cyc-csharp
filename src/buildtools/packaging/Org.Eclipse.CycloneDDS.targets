<Project>
  <UsingTask TaskName="Org.Eclipse.CycloneDDS.BuildTasks.GenerateIdl" AssemblyFile="$(CycloneDDSToolsPackageDirectory)/tools/net9.0/Org.Eclipse.CycloneDDS.BuildTasks.dll" />
  <Target Name="CycloneDDSGenerate" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <CycloneDDSGeneratedDirectory Condition="'$(CycloneDDSGeneratedDirectory)' == ''">$(IntermediateOutputPath)cyclonedds/</CycloneDDSGeneratedDirectory>
    </PropertyGroup>
    <Org.Eclipse.CycloneDDS.BuildTasks.GenerateIdl
      Condition="'$(DesignTimeBuild)' != 'true' and ('@(CycloneDDSIdl)' != '' or Exists('$(CycloneDDSGeneratedDirectory)'))"
      Sources="@(CycloneDDSIdl)" OutputDirectory="$(CycloneDDSGeneratedDirectory)"
      PackageDirectory="$(CycloneDDSToolsPackageDirectory)" ToolDirectory="$(CycloneDDSToolDirectory)"
      IncludeDirectories="@(CycloneDDSIdlInclude)" Defines="@(CycloneDDSIdlDefine)"
      DefaultExtensibility="$(CycloneDDSDefaultExtensibility)">
      <Output TaskParameter="GeneratedSources" ItemName="_CycloneDDSGenerated" />
      <Output TaskParameter="WrittenFiles" ItemName="FileWrites" />
    </Org.Eclipse.CycloneDDS.BuildTasks.GenerateIdl>
    <ItemGroup>
      <Compile Remove="@(_CycloneDDSGenerated)" />
      <Compile Include="@(_CycloneDDSGenerated)" />
      <Compile Include="$(CycloneDDSGeneratedDirectory)/*.cs" Condition="'$(DesignTimeBuild)' == 'true'" />
    </ItemGroup>
  </Target>
</Project>